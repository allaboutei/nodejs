<div class="blog-card">
    <h1><%=blog.title %></h1>
    <p><%=blog.intro %></p>
    <p><%=blog.body %></p>
    <p><strong><%= blog.createdAt  %></strong></p>
    <form action="/blogs/<%= blog._id %>/delete" method="post">
      <button class="delete-btn" type="submit">Delete</button>
    </form>
  </div>