<!DOCTYPE html>
<html lang="en">
  <%- include('./components/head.ejs') %>

  <body>
    <%- include('./components/nav.ejs') %>
    <div class="container">
      <% if(blogs.length){ blogs.forEach(blog=>{ %>
      <div class="blog-card">
        <h1><%=blog.title %></h1>
        <p><%=blog.intro %></p>
        <p><%=blog.body %></p>
      </div>

      <% }) } else{ %>
      <h3>No Blog Found</h3>
      <% }; %>
    </div>
  </body>
</html>
