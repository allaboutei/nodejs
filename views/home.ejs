
      <% if(blogs.length){ blogs.forEach(blog=>{ %>
      <div class="blog-card">
        <h1><%=blog.title %></h1>
        <p><%=blog.intro %></p>
        <p><%=blog.body %></p>
        <a class="blog-link" href="blogs/<%= blog._id %>">Read More</a>
        <button></button>
      </div>
      <% }) } else{ %>
      <h3>No Blog Found</h3>
      <% }; %>
      
  
 
